{
  "buildCommand": "cd ../.. && pnpm install && pnpm --filter @ipasounddrill/web build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/en", "destination": "/en/index.html" },
    { "source": "/ja", "destination": "/ja/index.html" },
    { "source": "/ko", "destination": "/ko/index.html" },
    { "source": "/zh-Hans", "destination": "/zh-Hans/index.html" },
    { "source": "/zh-Hant", "destination": "/zh-Hant/index.html" },
    { "source": "/fil", "destination": "/fil/index.html" },
    { "source": "/es", "destination": "/es/index.html" },
    { "source": "/pt-BR", "destination": "/pt-BR/index.html" },
    { "source": "/vi", "destination": "/vi/index.html" },
    { "source": "/id", "destination": "/id/index.html" },
    { "source": "/ru", "destination": "/ru/index.html" },
    { "source": "/th", "destination": "/th/index.html" },
    { "source": "/hi", "destination": "/hi/index.html" },
    { "source": "/tr", "destination": "/tr/index.html" },
    { "source": "/wordlist_GA_a1a2_plus_phonics.json", "destination": "/data/wordlist.json" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "missing": [
        {
          "type": "host",
          "value": "ipasounddrill\\.app"
        }
      ],
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    }
  ]
}
